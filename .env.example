# =====================================================================
# Marichi Labs website: environment settings
# On Vercel: Project, Settings, Environment Variables. Never commit real values.
# =====================================================================

NEXT_PUBLIC_SITE_URL=https://marichilabs.com

# ---- Newsletter: Mailchimp (subscribers, double opt-in, unsubscribes, sending) ----
MAILCHIMP_API_KEY=                 # Mailchimp: Account, Extras, API keys (ends in -us21 or similar)
MAILCHIMP_AUDIENCE_ID=             # Audience, Settings, Audience name and defaults
MAILCHIMP_REPLY_TO=                # where replies go, e.g. hello@marichisolutions.com
MAILCHIMP_FROM_NAME="The Marichi Weekly"

# ---- Schedule (optional) ----
NEWSLETTER_TZ=Africa/Lusaka                      # timezone that decides what "Friday" means
NEWSLETTER_SCHEDULE=Friday:tech,Saturday:sales   # weekday:blog pairs
NEWSLETTER_START_DATE=                           # YYYY-MM-DD, skip posts older than this

# ---- Security ----
CRON_SECRET=                       # 16+ random characters. Vercel sends it to the scheduled job automatically
ADMIN_PASSWORD=                    # 16+ characters, for /admin. If empty, CRON_SECRET is used

# ---- Storage (set automatically when you connect the integrations in Vercel) ----
# Storage tab, Upstash Redis:  KV_REST_API_URL, KV_REST_API_TOKEN       (posts, rate limits, form records)
# Storage tab, Blob:           BLOB_READ_WRITE_TOKEN                    (images uploaded in the editor)

# ---- Analytics (optional) ----
# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX). It loads ONLY after a visitor accepts analytics cookies.
NEXT_PUBLIC_GA_ID=

# ---- Optional ----
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEWSLETTER_WEBHOOK_URL=            # also copy sign-ups to a sheet/CRM (Zapier, Make)
LEAD_WEBHOOK_URL=
WAITLIST_WEBHOOK_URL=

# ---- Fallback when Mailchimp is not connected (local development only) ----
# RESEND_API_KEY=
# NEWSLETTER_FROM="The Marichi Weekly <news@yourdomain.com>"
